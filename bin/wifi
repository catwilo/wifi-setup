#!/usr/bin/env bash
# bin/wifi -- wifi-setup CLI (NetworkManager backbone).
#
# RESPONSABILIDAD UNICA: dispatch de subcomandos. Cada _cmd_* valida
# argumentos minimos, sourcea el lib correspondiente y llama la funcion.
# La logica real vive en lib/*.sh.
#
# Uso desde repo : sudo ./bin/wifi <cmd> [args]
# Uso tras instalar : sudo wifi <cmd> [args]
#
# Requiere: root para todo excepto status/list/networks/version/help.
set -Eeuo pipefail
IFS=$'\n\t'

# Resolver el symlink: /usr/local/bin/wifi apunta al repo. Sin esto,
# _SELF_DIR seria /usr/local/bin y LIB_DIR /usr/local/lib (no existe).
_SELF="${BASH_SOURCE[0]}"
if _real="$(readlink -f "${_SELF}" 2>/dev/null)" && [[ -n "${_real}" ]]; then
    _SELF="${_real}"
else
    while [[ -L "${_SELF}" ]]; do
        _link="$(readlink "${_SELF}")"
        case "${_link}" in
            /*) _SELF="${_link}" ;;
            *)  _SELF="$(dirname "${_SELF}")/${_link}" ;;
        esac
    done
fi
_SELF_DIR="$(cd "$(dirname "${_SELF}")" && pwd)"

if [[ -t 1 ]]; then
    _R='\033[0;31m'; _X='\033[0m'
else
    _R=''; _X=''
fi

_die() { echo -e "${_R}error: $*${_X}" >&2; exit 1; }

PROJECT_ROOT="$(cd "${_SELF_DIR}/.." && pwd)"
LIB_DIR="${PROJECT_ROOT}/lib"
SCRIPTS_DIR="${PROJECT_ROOT}"

[[ -f "${LIB_DIR}/common.sh" ]] \
    || _die "lib/common.sh no encontrado en ${LIB_DIR}"

# ---------------------------------------------------------------------------
# _load <lib...> -- sourcea common.sh + libs pedidos.
# ---------------------------------------------------------------------------
_load() {
    # shellcheck source=/dev/null
    source "${LIB_DIR}/common.sh"
    local lib
    for lib in "$@"; do
        # shellcheck source=/dev/null
        source "${LIB_DIR}/${lib}.sh"
    done
}

# ---------------------------------------------------------------------------
# _load_help -- sourcea common.sh + help.sh (solo cuando se pide ayuda).
# ---------------------------------------------------------------------------
_load_help() {
    # shellcheck source=/dev/null
    source "${LIB_DIR}/common.sh"
    # shellcheck source=/dev/null
    source "${LIB_DIR}/help.sh"
}

# ---------------------------------------------------------------------------
# _maybe_help <topic> [args...] -- si el primer arg es -h/--help, imprime
# la ayuda del topic y sale 0. El topic normaliza '-' a '_' para que
# "usb-names" resuelva a "help_usb_names".
# ---------------------------------------------------------------------------
_maybe_help() {
    local topic="${1//-/_}"; shift
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        _load_help
        if declare -F "help_${topic}" >/dev/null 2>&1; then
            "help_${topic}"
        else
            printf 'error: no hay ayuda para "%s"\n' "${topic}" >&2
            exit 1
        fi
        exit 0
    fi
}

# ---------------------------------------------------------------------------
# install / uninstall / check -- entrypoints separados.
# ---------------------------------------------------------------------------
_cmd_install() {
    _maybe_help install "$@"

    exec bash "${SCRIPTS_DIR}/install.sh" "$@"
}
_cmd_uninstall() {
    _maybe_help uninstall "$@"

    exec bash "${SCRIPTS_DIR}/uninstall.sh" "$@"
}
_cmd_check() {
    _maybe_help check "$@"

    exec bash "${SCRIPTS_DIR}/checks.sh" "$@"
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------
_cmd_status() {
    _maybe_help status "$@"

    _load nm radio
    require_root

    section "NetworkManager"
    if systemctl is-active NetworkManager >/dev/null 2>&1; then
        ok "activo"
    else
        warn "inactivo"
    fi

    section "Antenas WiFi"
    radio_list

    section "Devices NM"
    nm_dev_list

    section "Conexiones"
    nm_summary

    section "LAN"
    source "${LIB_DIR}/lan.sh"
    lan_status

    section "VPN"
    source "${LIB_DIR}/vpn.sh"
    vpn_status 2>/dev/null | head -5 || echo "  (no disponible)"

    section "Internet"
    if ping -c1 -W2 1.1.1.1 >/dev/null 2>&1; then
        ok "OK"
    else
        warn "sin conectividad"
    fi
}

# ---------------------------------------------------------------------------
# ifaces -- inventario fisico completo de antenas WiFi.
# Muestra lo que el kernel ve + lo que NM ve, mas adaptadores USB
# presentes en el bus que no cargaron driver.
# ---------------------------------------------------------------------------
_cmd_ifaces() {
    _maybe_help ifaces "$@"

    _load nm radio
    # Solo lectura: no requiere root.

    section "Antenas WiFi (kernel + NM)"
    radio_ifaces_list || true

    echo ""
}

# ---------------------------------------------------------------------------
# radio <list|primary|secondary|use|clear-session|up|down>
# ---------------------------------------------------------------------------
_cmd_radio() {
    _maybe_help radio "$@"

    local sub="${1:-}"
    shift || true
    [[ -n "${sub}" ]] || _die "uso: wifi radio <list|primary|secondary|use|clear-session|up|down> [args]"

    _load nm radio
    require_root

    case "${sub}" in
        list)          radio_list ;;
        primary)       radio_set_primary   "${1:-}" ;;
        secondary)     radio_set_secondary "${1:-}" ;;
        use)           radio_use           "${1:-}" ;;
        clear-session) radio_clear_session ;;
        up)            radio_up   "$@" ;;
        down)          radio_down "$@" ;;
        *) _die "subcomando desconocido: ${sub}" ;;
    esac
}

# ---------------------------------------------------------------------------
# add <ssid> [--iface X] [--pass P] -- crear perfil WiFi.
# ---------------------------------------------------------------------------
_cmd_add() {
    _maybe_help add "$@"

    _load nm radio
    require_root

    local ssid="" iface="" pass=""
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --iface) iface="${2:-}"; shift 2 ;;
            --pass)  pass="${2:-}";  shift 2 ;;
            -h|--help)
                echo "uso: wifi add <ssid> [--iface X] [--pass P]"
                echo ""
                echo "Crea un perfil WiFi. Sin --iface usa la antena PRIMARY"
                echo "(o la unica disponible). Sin --pass lo pide interactivo."
                exit 0 ;;
            *)
                if [[ -z "${ssid}" ]]; then
                    ssid="$1"
                else
                    _die "argumento inesperado: $1"
                fi
                shift
                ;;
        esac
    done
    [[ -n "${ssid}" ]] || _die "uso: wifi add <ssid> [--iface X]"

    if [[ -z "${iface}" ]]; then
        _radio_load_state
        iface="${RADIO_PRIMARY:-$(radio_ifaces | head -1)}"
        [[ -n "${iface}" ]] || _die "no hay antenas WiFi -- verifica hardware"
    fi
    radio_is_iface "${iface}" || _die "'${iface}' no es WiFi"

    if [[ -z "${pass}" ]]; then
        read -r -s -p "PSK para '${ssid}' (min 8): " pass
        echo
    fi
    [[ "${#pass}" -ge 8 ]] || _die "PSK minimo 8 caracteres"

    local profile="wifi-${iface}-${ssid}"
    nm_wifi_create "${profile}" "${iface}" "${ssid}" "${pass}"
    nm_con_set_autoconnect "${profile}" on
    ok "red '${ssid}' agregada en ${iface} (perfil: ${profile})"
}

# ---------------------------------------------------------------------------
# networks <list|merge|sync>
#   list   tabla unificada del store + presencia del perfil NM
#   merge  funde perfiles NM actuales al store (aditivo, nunca borra)
#   sync   regenera perfiles NM desde el store (idempotente)
# ---------------------------------------------------------------------------
_cmd_networks() {
    _maybe_help networks "$@"

    local sub="${1:-list}"
    shift || true

    _load nm radio networks
    require_root

    case "${sub}" in
        list|"") networks_list ;;
        merge)   networks_merge ;;
        sync)    networks_sync ;;
        *) _die "uso: wifi networks <list|merge|sync>" ;;
    esac
}

# ---------------------------------------------------------------------------
# switch <ssid> [--iface X] -- cambiar a un perfil WiFi guardado.
# ---------------------------------------------------------------------------
_cmd_switch() {
    _maybe_help switch "$@"

    _load nm radio
    require_root

    local ssid="${1:-}" iface="${2:-}"
    [[ -n "${ssid}" ]] || _die "uso: wifi switch <ssid> [iface]"

    if [[ -z "${iface}" ]]; then
        _radio_load_state
        iface="${RADIO_PRIMARY:-$(radio_ifaces | head -1)}"
    fi

    local profile="wifi-${iface}-${ssid}"
    nm_con_exists "${profile}" \
        || _die "perfil '${profile}' no existe -- usa: wifi add ${ssid} --iface ${iface}"

    nm_con_up "${profile}"
}

# ---------------------------------------------------------------------------
# passwd <profile> -- cambiar PSK de un perfil.
# ---------------------------------------------------------------------------
_cmd_passwd() {
    _maybe_help passwd "$@"

    _load nm
    require_root

    local profile="${1:-}"
    [[ -n "${profile}" ]] || _die "uso: wifi passwd <profile>  (ver: wifi networks)"

    nm_con_exists "${profile}" || _die "perfil '${profile}' no existe"

    local psk
    read -r -s -p "nuevo PSK (min 8): " psk; echo
    [[ "${#psk}" -ge 8 ]] || _die "minimo 8 caracteres"

    nmcli con mod "${profile}" 802-11-wireless-security.psk "${psk}"
    nmcli con up "${profile}" >/dev/null
    ok "PSK actualizado y reconectado"
}

# ---------------------------------------------------------------------------
# showpass <profile> -- PSK en claro del perfil.
# ---------------------------------------------------------------------------
_cmd_showpass() {
    _maybe_help showpass "$@"

    _load nm
    require_root

    local profile="${1:-}"
    [[ -n "${profile}" ]] || _die "uso: wifi showpass <profile>"

    nm_con_exists "${profile}" || _die "perfil '${profile}' no existe"
    local psk
    psk="$(nmcli -s -g 802-11-wireless-security.psk con show "${profile}" 2>/dev/null || true)"
    if [[ -n "${psk}" ]]; then
        echo "perfil : ${profile}"
        echo "psk    : ${psk}"
    else
        echo "perfil : ${profile}"
        echo "psk    : (no disponible -- el perfil no expone la clave)"
    fi
}

# ---------------------------------------------------------------------------
# setmac <profile> <mac|random|stable|permanent>
# ---------------------------------------------------------------------------
_cmd_setmac() {
    _maybe_help setmac "$@"

    _load nm
    require_root

    local profile="${1:-}" mac="${2:-}"
    [[ -n "${profile}" && -n "${mac}" ]] || _die "uso: wifi setmac <profile> <mac|random|stable|permanent>"

    nm_con_exists "${profile}" || _die "perfil '${profile}' no existe"

    case "$(nm_con_get "${profile}" connection.type)" in
        802-11-wireless) nm_con_set_mac_wifi "${profile}" "${mac}" ;;
        802-3-ethernet)  nm_con_set_mac      "${profile}" "${mac}" ;;
        *) _die "tipo de perfil no soportado" ;;
    esac
    ok "MAC de '${profile}' -> ${mac}"
}

# ---------------------------------------------------------------------------
# showmac <profile>
# ---------------------------------------------------------------------------
_cmd_showmac() {
    _maybe_help showmac "$@"

    _load nm
    require_root

    local profile="${1:-}"
    [[ -n "${profile}" ]] || _die "uso: wifi showmac <profile>"

    local type mac
    type="$(nm_con_get "${profile}" connection.type)"
    case "${type}" in
        802-11-wireless) mac="$(nm_con_get "${profile}" 802-11-wireless.cloned-mac-address)" ;;
        802-3-ethernet)  mac="$(nm_con_get "${profile}" 802-3-ethernet.cloned-mac-address)"  ;;
    esac
    echo "perfil : ${profile}"
    echo "cloned-mac-address : ${mac:-permanent}"
}

# ---------------------------------------------------------------------------
# autoconnect <profile> <on|off>
# ---------------------------------------------------------------------------
_cmd_autoconnect() {
    _maybe_help autoconnect "$@"

    _load nm
    require_root

    local profile="${1:-}" mode="${2:-}"
    [[ -n "${profile}" && -n "${mode}" ]] || _die "uso: wifi autoconnect <profile> <on|off>"
    nm_con_exists "${profile}" || _die "perfil '${profile}' no existe"
    nm_con_set_autoconnect "${profile}" "${mode}"
    ok "${profile} autoconnect=${mode}"
}

# ---------------------------------------------------------------------------
# panic -- recuperacion de emergencia.
# ---------------------------------------------------------------------------
_cmd_panic() {
    _maybe_help panic "$@"

    _load nm
    require_root

    warn "PANIC: reiniciando NetworkManager..."
    systemctl restart NetworkManager
    sleep 3

    local iface
    while IFS= read -r iface; do
        [[ -n "${iface}" ]] || continue
        info "reconectando ${iface}..."
        nmcli dev connect "${iface}" 2>/dev/null || true
    done < <(radio_ifaces)

    ok "recuperacion completa"
    nm_dev_list
}

# ---------------------------------------------------------------------------
# monitor <on|off|status> [iface]
# Cambia una antena entre managed y monitor, sin tocar las demas.
# ---------------------------------------------------------------------------
_cmd_monitor() {
    _maybe_help monitor "$@"

    local sub="${1:-}"
    shift || true

    _load nm radio monitor
    require_root

    case "${sub}" in
        on)     monitor_on     "${1:-}" ;;
        off)    monitor_off    "${1:-}" ;;
        status|"") monitor_status ;;
        *) _die "uso: wifi monitor <on|off|status> [iface]" ;;
    esac
}

# ---------------------------------------------------------------------------
# doctor [--fix]
# Diagnostico del stack. Sin flags, solo reporta. Con --fix, corrige
# los problemas conocidos de forma segura (no destructivo).
# ---------------------------------------------------------------------------
_cmd_doctor() {
    _maybe_help doctor "$@"

    _load nm radio doctor

    # Sin --fix es solo lectura: no requiere root. Con --fix necesita
    # root porque escribe .link, renombra perfiles NM y toca systemd.
    if [[ "${1:-}" == "--fix" ]]; then
        require_root
    fi

    doctor_run "$@"
}

# ---------------------------------------------------------------------------
# lan <setup|up|down|status|remove>
# ---------------------------------------------------------------------------
_cmd_lan() {
    _maybe_help lan "$@"

    local sub="${1:-}"
    shift || true

    _load nm lan
    require_root

    case "${sub}" in
        setup)  lan_setup "$@" ;;
        up)     lan_up ;;
        down)   lan_down ;;
        status) lan_status ;;
        remove) lan_remove ;;
        "")     lan_status ;;
        *) _die "subcomando desconocido: ${sub}" ;;
    esac
}

# ---------------------------------------------------------------------------
# usb-names <status|apply|edit>
# Gestiona el mapeo MAC -> nombre de iface USB WiFi.
# Fuente: config/usb-names.conf en BASE_DIR (si install corrio) o en el repo.
# ---------------------------------------------------------------------------
_cmd_usb_names() {
    _maybe_help usb_names "$@"

    local sub="${1:-}"
    shift || true

    _load nm
    require_root

    local cfg="${CONFIG_DIR}/usb-names.conf"
    [[ -f "${cfg}" ]] || cfg="${LIB_DIR}/../config/usb-names.conf"

    case "${sub}" in
        status|"")
            echo "usb-names.conf: ${cfg}"
            echo ""
            nm_usb_names_status "${cfg}"
            ;;
        apply)
            nm_usb_names_apply "${cfg}"
            ;;
        edit)
            [[ -f "${cfg}" ]] || { _die "no existe ${cfg} -- corre wifi install primero"; }
            "${EDITOR:-vi}" "${cfg}"
            info "re-aplica con: wifi usb-names apply"
            ;;
        *) _die "uso: wifi usb-names <status|apply|edit>" ;;
    esac
}

# ---------------------------------------------------------------------------
# vpn <install|up|down|status>
# ---------------------------------------------------------------------------
_cmd_vpn() {
    _maybe_help vpn "$@"

    local sub="${1:-}"
    shift || true

    _load vpn
    case "${sub}" in
        install) require_root; vpn_install ;;
        up)      require_root; vpn_up "$@" ;;
        down)    require_root; vpn_down ;;
        status)  vpn_status ;;
        "")      vpn_status ;;
        *) _die "subcomando desconocido: ${sub}" ;;
    esac
}

# ---------------------------------------------------------------------------
# scan [--iface X] -- escaneo de redes WiFi visibles.
# ---------------------------------------------------------------------------
_cmd_scan() {
    _maybe_help scan "$@"
    _load nm radio scan
    require_root
    scan_run "$@"
}

# ---------------------------------------------------------------------------
# version / help
# ---------------------------------------------------------------------------
_cmd_version() {
    echo "wifi-setup 2.0 (NetworkManager backbone)"
}

_cmd_help() {
    _load_help
    help_index
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
CMD="${1:-help}"
shift || true

case "${CMD}" in
    install)         _cmd_install "$@" ;;
    uninstall|remove) _cmd_uninstall "$@" ;;
    check|verify)    _cmd_check "$@" ;;
    status)          _cmd_status "$@" ;;
    ifaces)          _cmd_ifaces "$@" ;;
    radio)           _cmd_radio "$@" ;;
    scan)            _cmd_scan "$@" ;;
    add)             _cmd_add "$@" ;;
    networks)        _cmd_networks "$@" ;;
    switch)          _cmd_switch "$@" ;;
    passwd|password) _cmd_passwd "$@" ;;
    showpass)        _cmd_showpass "$@" ;;
    setmac)          _cmd_setmac "$@" ;;
    showmac)         _cmd_showmac "$@" ;;
    autoconnect)     _cmd_autoconnect "$@" ;;
    panic)           _cmd_panic "$@" ;;
    monitor)         _cmd_monitor "$@" ;;
    doctor)          _cmd_doctor "$@" ;;
    lan)             _cmd_lan "$@" ;;
    usb-names)       _cmd_usb_names "$@" ;;
    vpn)             _cmd_vpn "$@" ;;
    version|-v|--version) _cmd_version "$@" ;;
    help|-h|--help|"")    _cmd_help "$@" ;;
    *)
        echo "comando desconocido: '${CMD}'" >&2
        echo "usa: wifi help" >&2
        exit 1
        ;;
esac
