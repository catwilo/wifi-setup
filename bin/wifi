#!/usr/bin/env bash
# bin/wifi -- wifi-setup CLI (NetworkManager backbone).
#
# RESPONSABILIDAD UNICA: dispatch de subcomandos. Cada _cmd_* valida
# argumentos minimos, sourcea el lib correspondiente y llama la funcion.
# La logica real vive en lib/*.sh.
#
# Uso desde repo : sudo ./bin/wifi <cmd> [args]
# Uso tras instalar : sudo wifi <cmd> [args]
#
# Requiere: root para todo excepto status/list/networks/version/help.
set -Eeuo pipefail
IFS=$'\n\t'

_SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -t 1 ]]; then
    _R='\033[0;31m'; _X='\033[0m'
else
    _R=''; _X=''
fi

_die() { echo -e "${_R}error: $*${_X}" >&2; exit 1; }

PROJECT_ROOT="$(cd "${_SELF_DIR}/.." && pwd)"
LIB_DIR="${PROJECT_ROOT}/lib"
SCRIPTS_DIR="${PROJECT_ROOT}"

[[ -f "${LIB_DIR}/common.sh" ]] \
    || _die "lib/common.sh no encontrado en ${LIB_DIR}"

# ---------------------------------------------------------------------------
# _load <lib...> -- sourcea common.sh + libs pedidos.
# ---------------------------------------------------------------------------
_load() {
    # shellcheck source=/dev/null
    source "${LIB_DIR}/common.sh"
    local lib
    for lib in "$@"; do
        # shellcheck source=/dev/null
        source "${LIB_DIR}/${lib}.sh"
    done
}

# ---------------------------------------------------------------------------
# install / uninstall / check -- entrypoints separados.
# ---------------------------------------------------------------------------
_cmd_install() {
    exec bash "${SCRIPTS_DIR}/install.sh" "$@"
}
_cmd_uninstall() {
    exec bash "${SCRIPTS_DIR}/uninstall.sh" "$@"
}
_cmd_check() {
    exec bash "${SCRIPTS_DIR}/checks.sh" "$@"
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------
_cmd_status() {
    _load nm radio
    require_root

    section "NetworkManager"
    if systemctl is-active NetworkManager >/dev/null 2>&1; then
        ok "activo"
    else
        warn "inactivo"
    fi

    section "Antenas WiFi"
    radio_list

    section "Devices NM"
    nm_dev_list

    section "Conexiones"
    nm_summary

    section "LAN"
    source "${LIB_DIR}/lan.sh"
    lan_status

    section "VPN"
    source "${LIB_DIR}/vpn.sh"
    vpn_status 2>/dev/null | head -5 || echo "  (no disponible)"

    section "Internet"
    if ping -c1 -W2 1.1.1.1 >/dev/null 2>&1; then
        ok "OK"
    else
        warn "sin conectividad"
    fi
}

# ---------------------------------------------------------------------------
# radio <list|primary|secondary|use|clear-session|up|down>
# ---------------------------------------------------------------------------
_cmd_radio() {
    local sub="${1:-}"
    shift || true
    [[ -n "${sub}" ]] || _die "uso: wifi radio <list|primary|secondary|use|clear-session|up|down> [args]"

    _load nm radio
    require_root

    case "${sub}" in
        list)          radio_list ;;
        primary)       radio_set_primary   "${1:-}" ;;
        secondary)     radio_set_secondary "${1:-}" ;;
        use)           radio_use           "${1:-}" ;;
        clear-session) radio_clear_session ;;
        up)            radio_up   "$@" ;;
        down)          radio_down "$@" ;;
        *) _die "subcomando desconocido: ${sub}" ;;
    esac
}

# ---------------------------------------------------------------------------
# add <ssid> [--iface X] [--pass P] -- crear perfil WiFi.
# ---------------------------------------------------------------------------
_cmd_add() {
    _load nm radio
    require_root

    local ssid="" iface="" pass=""
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --iface) iface="${2:-}"; shift 2 ;;
            --pass)  pass="${2:-}";  shift 2 ;;
            -h|--help)
                echo "uso: wifi add <ssid> [--iface X] [--pass P]"
                echo ""
                echo "Crea un perfil WiFi. Sin --iface usa la antena PRIMARY"
                echo "(o la unica disponible). Sin --pass lo pide interactivo."
                exit 0 ;;
            *)
                if [[ -z "${ssid}" ]]; then
                    ssid="$1"
                else
                    _die "argumento inesperado: $1"
                fi
                shift
                ;;
        esac
    done
    [[ -n "${ssid}" ]] || _die "uso: wifi add <ssid> [--iface X]"

    if [[ -z "${iface}" ]]; then
        _radio_load_state
        iface="${RADIO_PRIMARY:-$(radio_ifaces | head -1)}"
        [[ -n "${iface}" ]] || _die "no hay antenas WiFi -- verifica hardware"
    fi
    radio_is_iface "${iface}" || _die "'${iface}' no es WiFi"

    if [[ -z "${pass}" ]]; then
        read -r -s -p "PSK para '${ssid}' (min 8): " pass
        echo
    fi
    [[ "${#pass}" -ge 8 ]] || _die "PSK minimo 8 caracteres"

    local profile="wifi-${iface}-${ssid}"
    nm_wifi_create "${profile}" "${iface}" "${ssid}" "${pass}"
    nm_con_set_autoconnect "${profile}" on
    ok "red '${ssid}' agregada en ${iface} (perfil: ${profile})"
}

# ---------------------------------------------------------------------------
# networks -- listar perfiles WiFi guardados.
# ---------------------------------------------------------------------------
_cmd_networks() {
    _load nm
    require_root

    local name type dev auto prio
    while IFS=: read -r name _uuid type dev; do
        [[ "${type}" == "802-11-wireless" ]] || continue
        auto="$(nm_con_get "${name}" connection.autoconnect)"
        prio="$(nm_con_get "${name}" connection.autoconnect-priority)"
        printf '  %-30s iface=%-15s autoconnect=%-3s prio=%s\n' \
            "${name}" "${dev:-—}" "${auto:-—}" "${prio:-0}"
    done < <(nm_con_list)
}

# ---------------------------------------------------------------------------
# switch <ssid> [--iface X] -- cambiar a un perfil WiFi guardado.
# ---------------------------------------------------------------------------
_cmd_switch() {
    _load nm radio
    require_root

    local ssid="${1:-}" iface="${2:-}"
    [[ -n "${ssid}" ]] || _die "uso: wifi switch <ssid> [iface]"

    if [[ -z "${iface}" ]]; then
        _radio_load_state
        iface="${RADIO_PRIMARY:-$(radio_ifaces | head -1)}"
    fi

    local profile="wifi-${iface}-${ssid}"
    nm_con_exists "${profile}" \
        || _die "perfil '${profile}' no existe -- usa: wifi add ${ssid} --iface ${iface}"

    nm_con_up "${profile}"
}

# ---------------------------------------------------------------------------
# passwd <profile> -- cambiar PSK de un perfil.
# ---------------------------------------------------------------------------
_cmd_passwd() {
    _load nm
    require_root

    local profile="${1:-}"
    [[ -n "${profile}" ]] || _die "uso: wifi passwd <profile>  (ver: wifi networks)"

    nm_con_exists "${profile}" || _die "perfil '${profile}' no existe"

    local psk
    read -r -s -p "nuevo PSK (min 8): " psk; echo
    [[ "${#psk}" -ge 8 ]] || _die "minimo 8 caracteres"

    nmcli con mod "${profile}" 802-11-wireless-security.psk "${psk}"
    nmcli con up "${profile}" >/dev/null
    ok "PSK actualizado y reconectado"
}

# ---------------------------------------------------------------------------
# showpass <profile> -- PSK en claro del perfil.
# ---------------------------------------------------------------------------
_cmd_showpass() {
    _load nm
    require_root

    local profile="${1:-}"
    [[ -n "${profile}" ]] || _die "uso: wifi showpass <profile>"

    nm_con_exists "${profile}" || _die "perfil '${profile}' no existe"
    local psk
    psk="$(nmcli -s -g 802-11-wireless-security.psk con show "${profile}" 2>/dev/null || true)"
    if [[ -n "${psk}" ]]; then
        echo "perfil : ${profile}"
        echo "psk    : ${psk}"
    else
        echo "perfil : ${profile}"
        echo "psk    : (no disponible -- el perfil no expone la clave)"
    fi
}

# ---------------------------------------------------------------------------
# setmac <profile> <mac|random|stable|permanent>
# ---------------------------------------------------------------------------
_cmd_setmac() {
    _load nm
    require_root

    local profile="${1:-}" mac="${2:-}"
    [[ -n "${profile}" && -n "${mac}" ]] || _die "uso: wifi setmac <profile> <mac|random|stable|permanent>"

    nm_con_exists "${profile}" || _die "perfil '${profile}' no existe"

    case "$(nm_con_get "${profile}" connection.type)" in
        802-11-wireless) nm_con_set_mac_wifi "${profile}" "${mac}" ;;
        802-3-ethernet)  nm_con_set_mac      "${profile}" "${mac}" ;;
        *) _die "tipo de perfil no soportado" ;;
    esac
    ok "MAC de '${profile}' -> ${mac}"
}

# ---------------------------------------------------------------------------
# showmac <profile>
# ---------------------------------------------------------------------------
_cmd_showmac() {
    _load nm
    require_root

    local profile="${1:-}"
    [[ -n "${profile}" ]] || _die "uso: wifi showmac <profile>"

    local type mac
    type="$(nm_con_get "${profile}" connection.type)"
    case "${type}" in
        802-11-wireless) mac="$(nm_con_get "${profile}" 802-11-wireless.cloned-mac-address)" ;;
        802-3-ethernet)  mac="$(nm_con_get "${profile}" 802-3-ethernet.cloned-mac-address)"  ;;
    esac
    echo "perfil : ${profile}"
    echo "cloned-mac-address : ${mac:-permanent}"
}

# ---------------------------------------------------------------------------
# autoconnect <profile> <on|off>
# ---------------------------------------------------------------------------
_cmd_autoconnect() {
    _load nm
    require_root

    local profile="${1:-}" mode="${2:-}"
    [[ -n "${profile}" && -n "${mode}" ]] || _die "uso: wifi autoconnect <profile> <on|off>"
    nm_con_exists "${profile}" || _die "perfil '${profile}' no existe"
    nm_con_set_autoconnect "${profile}" "${mode}"
    ok "${profile} autoconnect=${mode}"
}

# ---------------------------------------------------------------------------
# panic -- recuperacion de emergencia.
# ---------------------------------------------------------------------------
_cmd_panic() {
    _load nm
    require_root

    warn "PANIC: reiniciando NetworkManager..."
    systemctl restart NetworkManager
    sleep 3

    local iface
    while IFS= read -r iface; do
        [[ -n "${iface}" ]] || continue
        info "reconectando ${iface}..."
        nmcli dev connect "${iface}" 2>/dev/null || true
    done < <(radio_ifaces)

    ok "recuperacion completa"
    nm_dev_list
}

# ---------------------------------------------------------------------------
# lan <setup|up|down|status|remove>
# ---------------------------------------------------------------------------
_cmd_lan() {
    local sub="${1:-}"
    shift || true

    _load nm lan
    require_root

    case "${sub}" in
        setup)  lan_setup "$@" ;;
        up)     lan_up ;;
        down)   lan_down ;;
        status) lan_status ;;
        remove) lan_remove ;;
        "")     lan_status ;;
        *) _die "subcomando desconocido: ${sub}" ;;
    esac
}

# ---------------------------------------------------------------------------
# vpn <install|up|down|status>
# ---------------------------------------------------------------------------
_cmd_vpn() {
    local sub="${1:-}"
    shift || true

    _load vpn
    case "${sub}" in
        install) require_root; vpn_install ;;
        up)      require_root; vpn_up "$@" ;;
        down)    require_root; vpn_down ;;
        status)  vpn_status ;;
        "")      vpn_status ;;
        *) _die "subcomando desconocido: ${sub}" ;;
    esac
}

# ---------------------------------------------------------------------------
# version / help
# ---------------------------------------------------------------------------
_cmd_version() {
    echo "wifi-setup 2.0 (NetworkManager backbone)"
}

_cmd_help() {
    cat <<'HELP'
wifi-setup 2.0 -- WiFi + LAN + VPN sobre NetworkManager

USO
  sudo wifi <subcomando> [args]

INSTALACION
  sudo wifi install              instala NM, conecta antenas, crea perfiles
  sudo wifi uninstall            desinstala (iwd queda instalado, parado)
  sudo wifi check                verifica estado post-install

ESTADO
  wifi status                    NM, antenas, conexiones, LAN, VPN, internet

ANTENAS (nativa + USB)
  wifi radio list                tabla: iface, tipo, estado, conexion, rol
  sudo wifi radio primary <i>    persistente: i pasa a PRIMARY
  sudo wifi radio secondary <i>  persistente: i pasa a SECONDARY
  sudo wifi radio use <i>        solo esta sesion (no persiste)
  sudo wifi radio clear-session  olvida override de sesion
  sudo wifi radio up <i>         activa (watchdog 60s)
  sudo wifi radio up <i> --persist   activa + autoconnect on
  sudo wifi radio down <i>       desactiva (watchdog 45s)
  sudo wifi radio down <i> --persist desactiva + autoconnect off

REDES WiFi
  sudo wifi add <ssid>           crea perfil (interactivo PSK)
  sudo wifi add <ssid> --iface X --pass P
  wifi networks                  lista perfiles guardados
  sudo wifi switch <ssid> [iface]   cambia al perfil
  sudo wifi passwd <profile>     cambia PSK
  sudo wifi showpass <profile>   muestra PSK
  sudo wifi autoconnect <profile> <on|off>

MAC
  sudo wifi setmac <profile> <mac|random|stable|permanent>
  wifi showmac <profile>

LAN (cable ethernet, activacion manual)
  sudo wifi lan setup server --ip 1.2.3.2/24
  sudo wifi lan setup client --ip 1.2.3.1/24 --gw 1.2.3.2
  sudo wifi lan setup router
  sudo wifi lan setup auto
  sudo wifi lan up               activa (watchdog 75s)
  sudo wifi lan down             desactiva (watchdog 45s)
  wifi lan status                estado actual
  sudo wifi lan remove           borra perfil

VPN (Tailscale)
  sudo wifi vpn install          instala + daemon (sin conectar)
  sudo wifi vpn up               conecta
  sudo wifi vpn up --routes 1.2.3.0/24
  sudo wifi vpn up --advertise-exit-node
  sudo wifi vpn down             desconecta (daemon sigue)
  wifi vpn status                estado y peers

EMERGENCIA
  sudo wifi panic                reinicia NM, reconecta antenas

HELP
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
CMD="${1:-help}"
shift || true

case "${CMD}" in
    install)         _cmd_install "$@" ;;
    uninstall|remove) _cmd_uninstall "$@" ;;
    check|verify)    _cmd_check "$@" ;;
    status)          _cmd_status ;;
    radio)           _cmd_radio "$@" ;;
    add)             _cmd_add "$@" ;;
    networks)        _cmd_networks ;;
    switch)          _cmd_switch "$@" ;;
    passwd|password) _cmd_passwd "$@" ;;
    showpass)        _cmd_showpass "$@" ;;
    setmac)          _cmd_setmac "$@" ;;
    showmac)         _cmd_showmac "$@" ;;
    autoconnect)     _cmd_autoconnect "$@" ;;
    panic)           _cmd_panic ;;
    lan)             _cmd_lan "$@" ;;
    vpn)             _cmd_vpn "$@" ;;
    version|-v|--version) _cmd_version ;;
    help|-h|--help|"")    _cmd_help ;;
    *)
        echo "comando desconocido: '${CMD}'" >&2
        echo "usa: wifi help" >&2
        exit 1
        ;;
esac
